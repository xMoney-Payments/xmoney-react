{
  "name": "@xmoney/react",
  "version": "0.0.1",
  "description": "React components and hooks for the xMoney Checkout SDK",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "keywords": [
    "xmoney",
    "checkout",
    "payments",
    "react"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xMoney-Payments/xmoney-react.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "test": "vitest run",
    "prepublishOnly": "node scripts/check-deps.mjs && npm run typecheck && npm run lint && npm run test && npm run build",
    "example": "npm --prefix examples run dev"
  },
  "dependencies": {
    "@xmoney/xmoney-js": "^0.0.1"
  },
  "peerDependencies": {
    "react": ">=18 <20",
    "react-dom": ">=18 <20"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^26.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^3.2.4"
  }
}
