# Copy to .env and fill in your values.
# API_KEY is read by the Vite dev server only. Do not prefix it with VITE_.
# A leftover VITE_API_KEY is still accepted by the server, but Vite can inline
# any VITE_ value the client references, so prefer API_KEY.
VITE_PUBLIC_KEY=pk_test_xxxxx
API_KEY=your_api_key
VITE_API_BASE=https://demo.xmoney.com
VITE_CURRENCY=EUR
